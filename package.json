{
    "name": "3proxy-admin",
    "version": "0.5.0",
    "private": true,
    "type": "module",
    "overrides": {
        "effect": "^3.21.0"
    },
    "scripts": {
        "compile": "tsc -p tsconfig.scripts.json",
        "dev": "next dev --turbo",
        "build": "npm run compile && node ./dist/scripts/build.js",
        "build:docker": "node ./dist/scripts/build.js",
        "start": "echo Use 'npm run start:docker' for Docker or 'npm run dev' for development",
        "start:docker": "node ./dist/scripts/start.js",
        "lint": "eslint ./scripts ./src --ext .ts,.tsx --fix",
        "format": "prettier --write \"./src/**/*.{ts,tsx,json}\" \"./scripts/**/*.{ts,tsx,json}\" --no-error-on-unmatched-pattern",
        "format:check": "prettier --check \"./src/**/*.{ts,tsx,json}\" \"./scripts/**/*.{ts,tsx,json}\" --no-error-on-unmatched-pattern",
        "setup": "node ./dist/scripts/setup.js",
        "seed": "prisma db seed",
        "test:unit": "jest --passWithNoTests",
        "test:integration": "jest --selectProjects integration",
        "test:fail2ban": "jest --selectProjects fail2ban",
        "test:e2e": "npm run compile && tsx tests/e2e/index.ts",
        "test:e2e:traffic": "npm run compile && tsx tests/e2e/traffic-limit/run-all.test.ts",
        "test:e2e:fail2ban": "npm run compile && tsx tests/e2e/fail2ban-blocking/run-all.test.ts",
        "test:all": "npm run test:unit && npm run test:e2e"
    },
    "dependencies": {
        "@heroui/react": "^3.0.1",
        "@heroui/styles": "^3.0.1",
        "@heroui/theme": "^2.4.26",
        "@prisma/client": "^6.19.2",
        "@tailwindcss/postcss": "^4.2.2",
        "bcrypt": "^6.0.0",
        "clsx": "2.1.1",
        "globals": "^17.5.0",
        "jose": "^5.9.6",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.7.0",
        "nano-md5": "^1.0.5",
        "next": "^16.2.1",
        "next-themes": "^0.2.1",
        "qr-code-styling": "^1.8.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.54.2",
        "react-toastify": "^11.0.5",
        "prisma": "^6.19.2"
    },
    "devDependencies": {
        "@heroicons/react": "^2.2.0",
        "@next/eslint-plugin-next": "^15.1.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.2",
        "@types/node-cron": "^3.0.11",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@types/testing-library__jest-dom": "^5.14.9",
        "@typescript-eslint/eslint-plugin": "8.11.0",
        "@typescript-eslint/parser": "8.11.0",
        "autoprefixer": "10.4.19",
        "eslint": "^9.0.0",
        "eslint-config-next": "^16.2.1",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-unused-imports": "4.1.4",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.5.1",
        "node-cron": "^3.0.3",
        "postcss": "8.4.38",
        "prettier": "3.3.3",
        "tailwind-variants": "0.1.20",
        "tailwindcss": "^4.2.2",
        "ts-jest": "^29.4.12",
        "tsc-alias": "^1.8.0",
        "tsx": "^4.21.0",
        "typescript": "5.6.3",
        "vite": "^8.0.2"
    }
}
