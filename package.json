{
    "name": "3proxy-admin",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "overrides": {
        "effect": "^3.21.0"
    },
    "scripts": {
        "compile": "tsc -p tsconfig.scripts.json",
        "dev": "next dev --turbo",
        "build": "npm run compile && node ./dist/scripts/build.js",
        "build:docker": "node ./dist/scripts/build.js",
        "start": "echo Use 'npm run start:docker' for Docker or 'npm run dev' for development",
        "start:docker": "node ./dist/scripts/start.js",
        "lint": "eslint ./scripts ./src --ext .ts,.tsx --fix",
        "format": "prettier --write ./src/**/*.{ts,tsx,json} ./scripts/**/*.{ts,tsx,json}",
        "format:check": "prettier --check ./src/**/*.{ts,tsx,json} ./scripts/**/*.{ts,tsx,json}",
        "setup": "node ./dist/scripts/setup.js",
        "seed": "prisma db seed",
        "test:unit": "jest --passWithNoTests",
        "test:fail2ban": "npm run compile && node ./dist/tests/fail2ban-test.js",
        "test:e2e": "npm run compile && tsx tests/e2e/traffic-limit.test.ts",
        "test:e2e:fail2ban": "npm run compile && tsx tests/e2e/fail2ban-blocking.test.ts",
        "test:all": "npm run test:unit && npm run test:fail2ban && npm run test:e2e"
    },
    "dependencies": {
        "@heroui/react": "^3.0.1",
        "@heroui/styles": "^3.0.1",
        "@heroui/theme": "^2.4.26",
        "@prisma/client": "^6.19.2",
        "@tailwindcss/postcss": "^4.2.2",
        "bcrypt": "^6.0.0",
        "clsx": "2.1.1",
        "date-fns": "^4.1.0",
        "globals": "^17.5.0",
        "intl-messageformat": "^10.7.10",
        "jose": "^5.9.6",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.7.0",
        "moment": "^2.30.1",
        "next": "^16.2.1",
        "next-themes": "^0.2.1",
        "prisma": "^6.19.2",
        "qr-code-styling": "^1.8.4",
        "qrcode": "^1.5.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.54.2",
        "react-toastify": "^11.0.5",
        "slugify": "^1.6.6",
        "telegraf": "^4.16.3",
        "typescript-eslint": "^8.58.2",
        "uuid": "^11.0.3",
        "winston": "^3.18.3",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@heroicons/react": "^2.2.0",
        "@next/eslint-plugin-next": "^15.1.3",
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.19.37",
        "@types/node-cron": "^3.0.11",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@typescript-eslint/eslint-plugin": "8.11.0",
        "@typescript-eslint/parser": "8.11.0",
        "autoprefixer": "10.4.19",
        "eslint": "^9.0.0",
        "eslint-config-next": "^16.2.1",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-unused-imports": "4.1.4",
        "jest": "^30.3.0",
        "node-cron": "^3.0.3",
        "playwright": "^1.58.2",
        "postcss": "8.4.38",
        "prettier": "3.3.3",
        "tailwind-variants": "0.1.20",
        "tailwindcss": "^4.2.2",
        "tsc-alias": "^1.8.0",
        "tsx": "^4.21.0",
        "typescript": "5.6.3",
        "undici": "^7.25.0",
        "vite": "^8.0.2"
    }
}
