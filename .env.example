DATABASE_URL="file:./sqlite/app.db"

# JWT secret for authentication (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_this_in_production

# Panel login. Required on the first start: setup.ts falls back to admin/admin
# without it, and warns. Generate with: openssl rand -base64 18
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-start


NEXT_TELEMETRY_DISABLED=1

# Proxy configuration (must be prefixed with NEXT_PUBLIC_ for client-side access)
PROXY_DOMAIN=proxy.example.com
HTTP_PORT=8080
SOCKS_PORT=1080

# Traffic Sync Scheduler
# Path to 3proxy logs directory (default: /var/log/3proxy)
LOGS_DIR=/var/log/3proxy

